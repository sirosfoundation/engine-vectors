  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-authcode-001",
      "step": "as_discovered"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-authcode-001",
      "step": "trust_evaluated"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-authcode-001",
      "step": "authorization_url",
      "payload": {
       "authorization_url": "*",
       "expected_redirect_uri": "https://wallet.example/cb",
       "state": "*",
       "code_verifier": "*"
      }
     }
    }
   }
  },
  {
   "host_ask": {
    "expect": {
     "kind": "open_authorization",
     "inputs": {
      "flow_id": "flow-authcode-001",
      "url": "*"
     }
    },
    "answer": {
     "value": {}
    }
   }
  },
  {
   "wmp_in": {
    "method": "wmp.flow.action",
    "params": {
