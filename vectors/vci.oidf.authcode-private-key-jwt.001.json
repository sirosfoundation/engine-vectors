    },
    "reply": {
     "status": 200,
     "body": {
      "credential_issuer": "https://issuer.example",
      "authorization_servers": [
       "https://as.example"
      ],
      "credential_configurations_supported": {
       "UniversityDegree": {
        "scope": "openid"
       }
      }
