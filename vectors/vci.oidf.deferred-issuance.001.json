  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-oidf-deferred-001",
      "step": "metadata_fetched"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-oidf-deferred-001",
