{
 "id": "vci.oidf.deferred-issuance.001",
 "description": "The deferred issuance the OIDF suite's deferred variant validated: the credential endpoint's 202 acceptance with a transaction_id, the DPoP-bound polling of the metadata's deferred_credential_endpoint, the credential's arrival, and the sender-constrained notification.",
 "provenance": "oidf",
 "generator": {
  "repo": "sirosfoundation/siros-wallet-core",
  "commit": "09ab930b4d8f0565ec75bdcd102f28c427ba1ea1",
  "date": "2026-11-04"
 },
 "spec_refs": [
  "OpenID4VCI 1.0 section 8 (the deferred issuance: the 202 acceptance with the transaction_id)",
  "OpenID4VCI 1.0 section 9 (the deferred credential request to the metadata's deferred_credential_endpoint, authorized by the access token)",
  "RFC 9449 section 4.3 (the DPoP-bound token authorizes the deferred poll with a fresh ath-bound proof)",
  "OpenID4VCI 1.0 section 11.1 (the notification echoes the deferred credential response's notification_id)"
 ],
 "setup": {
  "time": 1700000000,
  "entropy_seed": 42,
  "pdp": {
   "trusted": true,
   "decision": "in the registry"
  }
 },
 "script": [
  {
   "wmp_in": {
    "method": "wmp.flow.start",
    "params": {
     "flow_id": "flow-oidf-deferred-001",
     "flow_type": "oid4vci",
     "params": {
      "credential_issuer": "https://issuer.example",
      "credential_configuration_ids": [
       "UniversityDegree"
      ],
      "grants": {
       "urn:ietf:params:oauth:grant-type:pre-authorized_code": {
        "pre-authorized_code": "preauth-code-oidf-deferred-001"
       }
      }
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "GET",
     "url": "https://issuer.example/.well-known/openid-credential-issuer",
     "purpose": "IssuerMetadata"
    },
    "reply": {
     "status": 200,
     "content_type": "application/json",
     "body": {
      "credential_issuer": "https://issuer.example",
      "authorization_servers": [
       "https://as.example"
      ],
      "credential_endpoint": "https://issuer.example/credential",
      "deferred_credential_endpoint": "https://issuer.example/deferred_credential",
      "notification_endpoint": "https://issuer.example/notification",
      "credential_configurations_supported": {
       "UniversityDegree": {
        "scope": "openid"
       }
      }
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "GET",
     "url": "https://as.example/.well-known/oauth-authorization-server",
     "purpose": "AsMetadata"
    },
    "reply": {
     "status": 200,
     "body": {
      "issuer": "https://as.example",
      "token_endpoint": "https://as.example/token"
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "POST",
     "url": "https://as.example/token",
     "purpose": "Token",
     "headers": {
      "DPoP": "*"
     },
     "form": {
      "grant_type": "urn:ietf:params:oauth:grant-type:pre-authorized_code",
      "pre-authorized_code": "preauth-code-oidf-deferred-001"
     }
    },
    "reply": {
     "status": 200,
     "body": {
      "access_token": "at-oidf-deferred-001",
      "token_type": "DPoP",
      "c_nonce": "nonce-oidf-deferred-001"
     }
    }
   }
  },
  {
   "host_ask": {
    "expect": {
     "kind": "signing_key"
    },
    "answer": {
     "value": {
      "jwk": {
       "kty": "EC",
       "crv": "P-256",
       "x": "ktT77AqMntawPyU772lBg8nd7cwENrYyOL_KWbYN8Jc",
       "y": "67lPXEq5gJdimDYD0AacxLfRfIm2-fSNd3HBqyXXvBI"
      }
     }
    }
   }
  },
  {
   "host_ask": {
    "expect": {
     "kind": "sign"
    },
    "answer": {
     "value": {
      "signature": [
       1,
       2,
       3,
       4
      ]
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "POST",
     "url": "https://issuer.example/credential",
     "purpose": "Credential",
     "headers": {
      "authorization": "DPoP at-oidf-deferred-001",
      "DPoP": "*"
     },
     "json": {
      "credential_configuration_id": "UniversityDegree",
      "proofs": {
       "jwt": [
        "*"
       ]
      }
     }
    },
    "reply": {
     "status": 202,
     "body": {
      "transaction_id": "transaction-oidf-deferred-001"
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "POST",
     "url": "https://issuer.example/deferred_credential",
     "purpose": "Deferred",
     "headers": {
      "authorization": "DPoP at-oidf-deferred-001",
      "DPoP": "*"
     },
     "json": {
      "transaction_id": "transaction-oidf-deferred-001"
     }
    },
    "reply": {
     "status": 200,
     "body": {
      "credential": "credential-jwt-oidf-deferred-001",
      "notification_id": "notif-oidf-deferred-001"
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "POST",
     "url": "https://issuer.example/notification",
     "purpose": "Notification",
     "headers": {
      "authorization": "DPoP at-oidf-deferred-001",
      "DPoP": "*"
     },
     "json": {
      "notification_id": "notif-oidf-deferred-001",
      "event": "credential_accepted"
     }
    },
    "reply": {
     "status": 200,
     "body": {}
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-oidf-deferred-001",
      "step": "parsing_offer"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-oidf-deferred-001",
      "step": "offer_parsed"
