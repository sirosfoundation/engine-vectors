{
 "id": "vci.encryption.encrypted-200.001",
 "description": "The encrypted answer after the key was offered decrypts and delivers: the issuer's metadata declares credential_response_encryption required, the wallet's request carries the ephemeral key, and the issuer answers a JWE to that key \u2014 which the vector cannot pre-bake, so the world builds it from the very JWK the engine offered (the encrypt_to_offer reply form). The engine decrypts and completes with the credential.",
 "provenance": "spec",
 "generator": {
  "repo": "sirosfoundation/siros-wallet-core",
  "commit": "6bf4a82b95985f31d455b38cf8394e2c99085464",
  "date": "2026-11-04"
 },
 "spec_refs": [
  "OpenID4VCI 1.0 section 7.3 (the response is encrypted to the key the Wallet offered)",
  "d.vci.plain-response-after-key in docs/decisions.md (the paired refusal)"
 ],
 "setup": {
  "time": 1700000000,
  "entropy_seed": 42,
  "pdp": {
   "trusted": true,
   "decision": "in the registry"
  }
 },
 "script": [
  {
   "wmp_in": {
    "method": "wmp.flow.start",
    "params": {
     "flow_id": "flow-encrypted-001",
     "flow_type": "oid4vci",
     "params": {
      "credential_issuer": "https://issuer.example",
      "credential_configuration_ids": [
       "EncryptedDegree"
      ],
      "grants": {
       "urn:ietf:params:oauth:grant-type:pre-authorized_code": {
        "pre-authorized_code": "preauth-encrypted-001"
       }
      }
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "GET",
     "url": "https://issuer.example/.well-known/openid-credential-issuer",
     "purpose": "IssuerMetadata"
    },
    "reply": {
     "status": 200,
     "body": {
      "credential_issuer": "https://issuer.example",
      "authorization_servers": [
       "https://as.example"
      ],
      "credential_configurations_supported": {
       "EncryptedDegree": {
        "scope": "openid",
        "credential_response_encryption": {
         "alg_values_supported": [
          "ECDH-ES"
         ],
         "enc_values_supported": [
          "A256GCM",
          "A128GCM"
         ],
         "encryption_required": true
        }
       }
      }
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "GET",
     "url": "https://as.example/.well-known/oauth-authorization-server",
     "purpose": "AsMetadata"
    },
    "reply": {
     "status": 200,
     "body": {
      "issuer": "https://as.example",
      "token_endpoint": "https://as.example/token"
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "POST",
     "url": "https://as.example/token",
     "purpose": "Token",
     "form": {
      "grant_type": "urn:ietf:params:oauth:grant-type:pre-authorized_code",
      "pre-authorized_code": "preauth-encrypted-001"
     }
    },
    "reply": {
     "status": 200,
     "body": {
      "access_token": "at-encrypted-001",
      "token_type": "Bearer",
      "c_nonce": "nonce-encrypted-001"
     }
    }
   }
  },
  {
   "host_ask": {
    "expect": {
     "kind": "sign"
    },
    "answer": {
     "value": {
      "signature": [
       1,
       2,
       3,
       4
      ]
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "POST",
     "url": "https://issuer.example/credential",
     "purpose": "Credential",
     "json": {
      "credential_configuration_id": "EncryptedDegree",
      "credential_response_encryption": {
       "enc": "A256GCM",
       "jwk": {
        "kty": "EC",
        "crv": "P-256",
        "x": "*",
        "y": "*"
       }
      }
     }
    },
    "reply": {
     "status": 200,
     "content_type": "application/jwt",
     "body": {
      "encrypt_to_offer": true,
      "plaintext": {
       "credential": "credential-jwt-encrypted-001",
       "notification_id": "notif-encryption-encrypted-200-001"
      }
     }
    }
   }
  },
  {
   "http_out": {
    "expect": {
     "method": "POST",
     "url": "https://issuer.example/notification",
     "purpose": "Notification",
     "json": {
      "notification_id": "notif-encryption-encrypted-200-001",
      "event": "credential_accepted"
     }
    },
    "reply": {
     "status": 200,
     "body": {}
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "parsing_offer"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "offer_parsed"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "fetching_metadata"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "metadata_fetched"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "as_discovered"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "evaluating_trust"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "trust_evaluated"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "exchanging_token"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "token_obtained"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "requesting_credential"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.progress",
     "params": {
      "flow_id": "flow-encrypted-001",
      "step": "credential_received"
     }
    }
   }
  },
  {
   "wmp_out": {
    "expect": {
     "method": "wmp.flow.complete",
     "params": {
      "flow_id": "flow-encrypted-001",
      "result": {
       "credential": "credential-jwt-encrypted-001",
       "deferred": false
      }
     }
    }
   }
  }
 ],
 "notes": "The encrypt_to_offer reply form is the point of this vector: the JWE body is built at run time from the very JWK the engine's request offered (the strongest possible assertion that the engine can decrypt what it asked for), where a pre-baked ciphertext could not assert it. The plain-refused twin (vci.encryption.plain-refused.001) is the Go-diverging refusal this one complements."
}