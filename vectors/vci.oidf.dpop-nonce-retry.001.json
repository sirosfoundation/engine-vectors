{
 "id": "vci.oidf.dpop-nonce-retry.001",
 "description": "The resource server's DPoP nonce demand on the credential endpoint (RFC 9449 section 8.1): the 401 use_dpop_nonce answer with a fresh DPoP-Nonce header is retried once with a new proof carrying the fresh nonce \u2014 the token response's nonce binds the AS, not the credential endpoint, so the resource server's own demand is answered the same way.",
 "provenance": "oidf",
 "generator": {
  "repo": "sirosfoundation/siros-wallet-core",
  "commit": "09ab930b4d8f0565ec75bdcd102f28c427ba1ea1",
  "date": "2026-11-04"
 },
 "spec_refs": [
  "RFC 9449 section 8.1 (the DPoP nonce: the 401 use_dpop_nonce with the DPoP-Nonce header, retried with the fresh nonce in the proof)",
  "RFC 9449 section 7.1 (the WWW-Authenticate error use_dpop_nonce)",
  "OpenID4VCI 1.0 section 7.5 (the proofs object the retried request carries again)"
 ],
 "setup": {
  "time": 1700000000,
  "entropy_seed": 42,
