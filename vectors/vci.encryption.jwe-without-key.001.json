{
  "id": "vci.encryption.jwe-without-key.001",
  "description": "A JWE-encrypted answer when no key was offered is REFUSED: the issuer's metadata declares no credential_response_encryption, the wallet's request carries no offer, and the credential endpoint answers a JWE anyway. There is nothing to decrypt it with, and accepting it would mean the engine invented a key \u2014 the flow refuses the moment the encrypted body arrives.",
  "provenance": "spec",
  "generator": {
    "repo": "sirosfoundation/siros-wallet-core",
    "commit": "d0e3ad6d0fb40235ea5e06370400c216e241cec2",
    "date": "2026-11-04"
  },
  "spec_refs": [
    "OpenID4VCI 1.0 section 7.3 (the response is encrypted to the key the Wallet offered)",
    "d.vci.encrypted-without-key in docs/decisions.md"
  ],
  "setup": {
    "time": 1700000000,
    "entropy_seed": 42,
    "pdp": {
      "trusted": true,
      "decision": "in the registry"
    }
  },
  "script": [
    {
      "wmp_in": {
        "method": "wmp.flow.start",
        "params": {
          "flow_id": "flow-jwe-nokey-001",
          "flow_type": "oid4vci",
          "params": {
            "credential_issuer": "https://issuer.example",
            "credential_configuration_ids": [
              "PlainDegree"
            ],
            "grants": {
              "urn:ietf:params:oauth:grant-type:pre-authorized_code": {
                "pre-authorized_code": "preauth-jwe-nokey-001"
              }
            }
          }
        }
      }
    },
    {
      "http_out": {
        "expect": {
          "method": "GET",
          "url": "https://issuer.example/.well-known/openid-credential-issuer",
          "purpose": "IssuerMetadata"
        },
        "reply": {
          "status": 200,
          "body": {
            "credential_issuer": "https://issuer.example",
            "authorization_servers": [
              "https://as.example"
            ],
            "credential_configurations_supported": {
              "PlainDegree": {
                "scope": "openid"
              }
            }
          }
        }
      }
    },
    {
      "http_out": {
        "expect": {
          "method": "GET",
          "url": "https://as.example/.well-known/oauth-authorization-server",
          "purpose": "AsMetadata"
        },
        "reply": {
          "status": 200,
          "body": {
            "issuer": "https://as.example",
            "token_endpoint": "https://as.example/token"
          }
        }
      }
    },
    {
      "http_out": {
        "expect": {
          "method": "POST",
          "url": "https://as.example/token",
          "purpose": "Token",
          "form": {
            "grant_type": "urn:ietf:params:oauth:grant-type:pre-authorized_code",
            "pre-authorized_code": "preauth-jwe-nokey-001"
          }
        },
        "reply": {
          "status": 200,
          "body": {
            "access_token": "at-jwe-nokey-001",
            "token_type": "Bearer",
            "c_nonce": "nonce-jwe-nokey-001"
          }
        }
      }
    },
    {
      "host_ask": {
        "expect": {
          "kind": "sign"
        },
        "answer": {
          "value": {
            "signature": [
              1,
              2,
              3,
              4
            ]
          }
        }
      }
    },
    {
      "http_out": {
        "expect": {
          "method": "POST",
          "url": "https://issuer.example/credential",
          "purpose": "Credential",
          "json": {
            "credential_configuration_id": "PlainDegree"
          }
        },
        "reply": {
          "status": 200,
          "content_type": "application/jwt",
          "body": "e30.e30.e30.e30.e30"
        }
      }
    },
    {
      "wmp_out": {
        "expect": {
          "method": "wmp.flow.start"
        },
        "must_refuse": true,
        "error_code": -31006
      }
    },
    {
      "wmp_out": {
        "expect": {
          "method": "wmp.flow.progress",
          "params": {
            "flow_id": "flow-jwe-nokey-001",
            "step": "offer_parsed"
          }
        }
      }
    },
    {
      "wmp_out": {
        "expect": {
          "method": "wmp.flow.progress",
          "params": {
            "flow_id": "flow-jwe-nokey-001",
            "step": "metadata_resolved"
          }
        }
      }
    },
    {
      "wmp_out": {
        "expect": {
          "method": "wmp.flow.progress",
          "params": {
            "flow_id": "flow-jwe-nokey-001",
            "step": "as_discovered"
          }
        }
      }
    },
    {
      "wmp_out": {
        "expect": {
          "method": "wmp.flow.progress",
          "params": {
            "flow_id": "flow-jwe-nokey-001",
            "step": "trust_evaluated"
          }
        }
      }
    },
    {
      "wmp_out": {
        "expect": {
          "method": "wmp.flow.progress",
          "params": {
            "flow_id": "flow-jwe-nokey-001",
            "step": "token_received"
          }
        }
      }
    }
  ],
  "notes": "The request carries no credential_response_encryption (the json expectation names only credential_configuration_id), so the encrypted body has no key to answer to. The refusal is the flow start's own answer; the progress emitted before the credential request still went out."
}
