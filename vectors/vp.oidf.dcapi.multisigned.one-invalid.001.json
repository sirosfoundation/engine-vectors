{
  "id": "vp.oidf.dcapi.multisigned.one-invalid.001",
  "description": "The multi-signed request object with one INVALID signature: at least one valid signature authenticates the verifier \u2014 the failing signature is skipped, the wallet presents through the browser channel. The multisigned-one-invalid-signature module invalidates the first on purpose, leaving the second valid; the wallet's acceptance is the suite-validated behaviour.",
  "provenance": "oidf",
  "generator": {
    "repo": "sirosfoundation/siros-wallet-core",
    "commit": "3a94dfd2768d0c547e77b40a58b7c197a1e70fca",
    "date": "2026-11-10"
  },
  "spec_refs": [
    "RFC 7515 section 7.2 (the JWS JSON Serialization \u2014 each signature independently verifiable)",
    "OpenID4VP 1.0 section 8.4 (the Digital Credentials API response modes)"
  ],
  "setup": {
    "time": 1700000000,
    "entropy_seed": 42,
    "pdp": {
      "trusted": true,
      "decision": "in the registry"
    }
  },
  "script": [
