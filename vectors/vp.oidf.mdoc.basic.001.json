     "params": {
      "client_id": "x509_san_dns:verifier.example",
      "nonce": "nonce-vp-mdoc-001",
      "response_uri": "https://verifier.example/response",
      "response_mode": "direct_post",
      "state": "state-vp-mdoc-001",
      "dcql_query": {
       "credentials": [
        {
         "id": "mdl-query",
         "format": "mso_mdoc",
         "meta": {
          "doctype_value": "org.iso.18013.5.1.mDL"
         },
         "claims": [
          {
           "path": [
            "org.iso.18013.5.1",
            "given_name"
           ]
          }
         ]
        }
       ]
      }
     }
    }
   }
  },
  {
   "host_ask": {
    "expect": {
     "kind": "match",
     "inputs": {
      "flow_id": "flow-vp-mdoc-001",
      "dcql_query": {
       "credentials": [
        {
         "id": "mdl-query",
         "format": "mso_mdoc",
         "meta": {
          "doctype_value": "org.iso.18013.5.1.mDL"
         },
         "claims": [
          {
           "path": [
            "org.iso.18013.5.1",
            "given_name"
           ]
          }
         ]
        }
       ]
      },
      "verifier": {
       "client_id": "x509_san_dns:verifier.example",
       "domain": "verifier.example",
       "trusted": true
      }
     }
    },
    "answer": {
     "value": {
      "selections": [
       {
        "credential_query_id": "mdl-query",
        "credential_id": "mini-mdl",
        "disclosed_claims": [
         "[\"org.iso.18013.5.1\", \"given_name\"]"
        ]
       }
      ]
     }
    }
   }
  },
  {
   "host_ask": {
    "expect": {
     "kind": "consent"
    },
    "answer": {
     "value": {
      "consented": true
     }
    }
   }
  },
  {
   "host_ask": {
    "expect": {
     "kind": "presentation",
     "inputs": {
      "flow_id": "flow-vp-mdoc-001",
      "audience": "x509_san_dns:verifier.example",
      "nonce": "nonce-vp-mdoc-001",
      "response_uri": "https://verifier.example/response",
      "selections": [
       {
        "credential_query_id": "mdl-query",
        "credential_id": "mini-mdl",
        "disclosed_claims": [
         "[\"org.iso.18013.5.1\", \"given_name\"]"
        ]
       }
      ]
