{
 "id": "vp.oidf.mdoc.basic.001",
 "description": "The mso_mdoc presentation (OpenID4VP 1.0, B.4): the DCQL query's [namespace, claim name] paths select the mDL's driver attributes, the host's presentation answer is the base64url DeviceResponse (ISO/IEC 18013-5, 8.3.2.1.2.2 \u2014 the selected items as issued, the issuerAuth COSE_Sign1 as issued, the device key's ES256 signature over the session transcript of the request's OpenID4VPHandover, B.2.6.1), and the engine structures the DCQL vp_token object keyed by the credential query id (\u00a78.1) over the direct_post form.",
 "provenance": "oidf",
 "generator": {
  "repo": "sirosfoundation/siros-wallet-core",
  "commit": "e6413e99f50ba1829ef13c047df95c478efa3456",
  "date": "2026-11-05"
 },
 "spec_refs": [
  "OpenID4VP 1.0 section B.4 (the mso_mdoc credential format and query)",
  "ISO/IEC 18013-5 section 8.3.2.1.2.2 (the DeviceResponse)",
  "OpenID4VP 1.0 section B.2.6.1 (the OpenID4VPHandover session transcript)",
  "OpenID4VP 1.0 section 8.1 (the DCQL vp_token object)"
 ],
 "setup": {
  "time": 1700000000,
  "entropy_seed": 42,
  "pdp": {
   "trusted": true,
   "decision": "in the registry"
  }
 },
